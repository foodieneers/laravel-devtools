{
    "name": "foodieneers/laravel-devtools",
    "description": "Foodieneers company-standard Laravel development toolkit (Pest, Pint, PHPStan, Rector, and related tooling).",
    "keywords": [
        "Foodieneers",
        "dev",
        "laravel",
        "laravel-devtools",
        "toolkit"
    ],
    "homepage": "https://github.com/foodieneers/laravel-devtools",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Azzarip",
            "email": "paride21azzari@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "driftingly/rector-laravel": "^2.4.0",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "larastan/larastan": "^3.10.0",
        "laravel/boost": "^2.4.8",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29.1",
        "llm/skills": "^1.9",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.4",
        "nunomaduro/mock-final-classes": "^1.2",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-evals": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.4",
        "phpstan/phpstan-phpunit": "^2.0.16",
        "rector/rector": "^2.4.5",
        "spatie/laravel-package-tools": "^1.93",
        "spatie/laravel-ray": "^1.43.9"
    },
    "require-dev": {
        "orchestra/testbench": "^11.1.0"
    },
    "autoload": {
        "psr-4": {
            "Foodieneers\\DevTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Foodieneers\\DevTools\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "lint": [
            "rector",
            "pint --parallel"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run"
        ],
        "test:unit": [
            "@putenv XDEBUG_MODE=coverage",
            "pest --testsuite=Unit --coverage --exactly=100.0"
        ],
        "test:arch": "pest tests/ArchTest.php",
        "pest": "pest --profile",
        "test:types": "phpstan --memory-limit=16G",
        "test": [
            "@test:type-coverage",
            "@test:unit",
            "@test:arch",
            "@test:lint",
            "@test:types"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "llm/skills": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Foodieneers\\DevTools\\DevToolsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
